# Copy to .env (git-ignored) and adjust. This file is the reference.
# Used by scheduling-api (ConfigModule) AND by docker-compose.

# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Session / JWT (Security spec §6) ────────────────────────────────
# Only the secret is configurable; the TTLs (15m / 5h) are fixed in code.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-insecure-change-me-at-least-16-chars

# ── Database (Postgres from docker-compose) ─────────────────────────
# The schema is managed by Atlas (see apps/scheduling-api/atlas.hcl).
DB_HOST=localhost
DB_PORT=5432
DB_USER=scheduling
DB_PASSWORD=scheduling
DB_NAME=scheduling
DB_LOGGING=false

# ── Email (SMTP) ───────────────────────────────────────────────────
# Local: Mailpit from docker-compose (no auth). UI at http://localhost:8025
# Prod: point at a real SMTP, e.g. Mailjet:
#   MAIL_HOST=in-v3.mailjet.com  MAIL_PORT=587  MAIL_SECURE=false
#   MAIL_USER=<API key>  MAIL_PASSWORD=<API secret>
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Scheduling <no-reply@scheduling.local>

# ── Frontend (scheduling-web) — portal admin da barbearia ───────────
# Lidas em build time pelo Next.js (NEXT_PUBLIC_*). Ver docs/arch/configuration.md.
# Enquanto a API não expõe Tenant/Owner para o front, servem de fallback
# para o ShopConfig (nome/slug/contato da barbearia exibidos no portal).
NEXT_PUBLIC_SHOP_NAME=Minha Barbearia
NEXT_PUBLIC_SHOP_SLUG=minha-barbearia
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_CNPJ=
NEXT_PUBLIC_SHOP_OWNER_NAME=Dono da barbearia
NEXT_PUBLIC_SHOP_OWNER_EMAIL=dono@example.com
NEXT_PUBLIC_PUBLIC_BOOKING_URL=https://barberadmin.app
