# Copie para .env (git-ignored) e ajuste. Este arquivo é a referência.
# Usado pelo marginalia-api (ConfigModule) E pelo docker-compose.

# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Sessão / JWT (spec Segurança §6) ────────────────────────────────
# Só o segredo é configurável; os TTLs (15m / 5h) são fixos no código.
# Gere um: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-insecure-change-me-com-ao-menos-16-chars

# ── Banco (Postgres do docker-compose) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=marginalia
DB_PASSWORD=marginalia
DB_NAME=marginalia
# dev: true deixa o TypeORM sincronizar o schema sozinho. NUNCA em produção.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── E-mail (SMTP) ──────────────────────────────────────────────────
# Local: Mailpit do docker-compose (sem auth). UI em http://localhost:8025
# Prod: aponte para um SMTP real, ex. Mailjet:
#   MAIL_HOST=in-v3.mailjet.com  MAIL_PORT=587  MAIL_SECURE=false
#   MAIL_USER=<API key>  MAIL_PASSWORD=<API secret>
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Marginália <no-reply@marginalia.local>
